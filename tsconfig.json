{
  "extends": "@tsconfig/vite-react/tsconfig.json",
  "include": [
    "src/**/*",
    "global.d.ts",
    "./dist/types/**/*.ts",
    "./next-env.d.ts"
, "types"  ],
  "exclude": ["./node_modules", "dist"],
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "esModuleInterop": true,
    "baseUrl": "src",
    "jsx": "react-jsx",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true
  }
}
